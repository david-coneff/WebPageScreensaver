<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the Windows Desktop targeting pack restore on Linux/macOS, so the release builds
         cross-compile there (the CI runner is ubuntu); a no-op on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <StartupObject>WebPageScreensaver.Program</StartupObject>
    <RootNamespace>WebPageScreensaver</RootNamespace>
    <AssemblyName>WebPageScreensaver</AssemblyName>
    <Version>2.0.2-Alpha</Version>
    <!-- Publish choices, kept identical in both Properties/PublishProfiles/*.pubxml and the
         release command in README.md:
         - PublishTrimmed false: trimming is not supported for Windows Forms (50ecb57), and a
           trimmed publish is the suspected cause of the broken theme in README's known issues.
         - PublishReadyToRun false: ReadyToRun only shortens startup, which a long-running
           screensaver rarely pays, and it adds size; the published release is built without it. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishReadyToRunShowWarnings>true</PublishReadyToRunShowWarnings>
    <Platforms>x64;x86</Platforms>
	<InvariantGlobalization>false</InvariantGlobalization>
	<EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- The WebView2 package references its WPF control on every .NET 5+ target, with no switch
       to turn it off. This app uses only the WinForms control; the WPF assembly's WindowsBase
       5.0 reference conflicts with .NET 10's (MSB3277), so it is dropped before resolution. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- MSBuild's own Copy task, not the OS `copy`/`cp` shell command: this runs identically
       whether the build is invoked from Windows, or cross-compiled from Linux/macOS (the
       committed .scr in this repo is built that way, via `dotnet publish -r win-x64`). -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Copy SourceFiles="$(TargetDir)$(TargetName).exe" DestinationFiles="$(TargetDir)$(TargetName).scr"
          Condition="Exists('$(TargetDir)$(TargetName).exe')" />
  </Target>

  <!-- A `dotnet publish` (single-file, self-contained — the PublishX64/X86 profiles) produces
       its packaged .exe by bundling AFTER the build's own PostBuildEvent already ran, so the
       target above copies nothing: at that point the intermediate dir holds only the
       unbundled .dll. This second target does the same rename against the PUBLISH output,
       once the real single-file .exe exists there. -->
  <Target Name="PostPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(TargetName).exe" DestinationFiles="$(PublishDir)$(TargetName).scr"
          Condition="Exists('$(PublishDir)$(TargetName).exe')" />
  </Target>

</Project>
